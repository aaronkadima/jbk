# Servidor
PORT=4000
NODE_ENV=development
# PostgreSQL. Sem esta variável o servidor usa um banco em memória (só para testar).
DATABASE_URL=postgres://jbk:jbk@localhost:5432/jbk
JWT_SECRET=troque-por-um-segredo-longo
# Conta de administração criada na primeira execução
ADMIN_PHONE=+5511999990000
ADMIN_PASSWORD=troque-esta-senha
# 1 = cria entregadores simulados perto de quem abre o mapa (demonstração)
DEMO=1
# Notificações push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
